[Unit]
Description=Student Union Check-in Board
After=network.target

[Service]
Type=simple
User=checkin
WorkingDirectory=/opt/checkin-board/current
EnvironmentFile=/opt/checkin-board/shared/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/checkin-board/shared

[Install]
WantedBy=multi-user.target
